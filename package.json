{
  "name": "@neolution-ch/action-check-licenses",
  "version": "0.6.0",
  "private": true,
  "description": "This action checks the repo for the npm and nuget licenses and adds a comment to the pull request",
  "homepage": "https://github.com/neolution-ch/action-check-licenses",
  "license": "MIT",
  "author": "Neolution",
  "main": "dist/index.js",
  "source": "src/index.ts",
  "engines": {
    "node": "^22.11 || ^24 || >=26",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "ncc build src/index.ts --license licenses.txt -o dist && shx sed -i \"s/\\x0D$//g\" ./dist/index.js",
    "changeset": "changeset",
    "prelint1": "git ls-files | xargs eclint check",
    "lint": "eslint --cache --max-warnings 0",
    "prettier-check": "prettier --check .",
    "prettier-write": "prettier --write .",
    "release": "changeset publish",
    "smoke": "tsc --outDir .smoke-build --noEmit false && node scripts/smoke-package-managers.mjs",
    "typecheck": "tsc --noEmit",
    "upgradeAll": "npm-check-updates --packageFile ./package.json -u",
    "version-packages": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neolution-ch/action-check-licenses"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^5.1.1",
    "@actions/io": "^1.1.3",
    "minimatch": "^9.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@neolution-ch/eslint-config-neolution": "^2.1.0",
    "@types/node": "^20.6.5",
    "@vercel/ncc": "^0.38.0",
    "eclint": "^2.8.1",
    "eslint": "^9.28.0",
    "npm-check-updates": "^16.14.4",
    "prettier": "^3.0.3",
    "shx": "^0.3.4",
    "typescript": "^4.8.4"
  }
}
