# dist/index.js is a committed ncc bundle, and webpack derives its module ids from resolved module
# paths. pnpm's default symlinked layout resolves differently on Windows (junctions) than on Linux,
# so a bundle built on one platform never matches one built on the other and the CI drift check
# fails for whoever is not on the same OS as the runner. A flat tree keeps the build reproducible.
node-linker=hoisted
